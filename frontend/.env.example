# ==============================================================================
# ScamShield Frontend (Vite + React) Environment Configuration Template
# ==============================================================================
# Copy this file to frontend/.env (or configure in Vercel/Netlify Dashboard).
# ==============================================================================

# Production Backend API URL
# - In local development with Vite dev server proxy: use '/api'
# - In production with separate backend (e.g. Render/Railway): use full URL + '/api'
#   Example: https://scamshield-api.onrender.com/api
VITE_API_BASE_URL=/api

# Optional: Demo Credentials Helper in Login Page
# In production, set to 'false' so admin credentials are not displayed to visitors.
# In local development / academic viva presentation, set to 'true' to enable the 1-click autofill button.
VITE_ENABLE_DEMO_CREDENTIALS=false
