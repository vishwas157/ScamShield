# ==============================================================================
# ScamShield — Unified Environment Configuration Template
# Academic Capstone Project: B.Tech IT Semester 7
# ==============================================================================
# IMPORTANT: This template contains placeholder values only.
# Do NOT commit actual secrets, API keys, or production passwords to source control.
# Copy this file to .env and configure with your deployment credentials.
# ==============================================================================

# Application Meta
PROJECT_NAME="ScamShield — Scam Number & UPI Community Database"
ENVIRONMENT=production
VERSION=1.0.0
API_V1_STR=/api
PORT=8000

# ------------------------------------------------------------------------------
# Database Configuration (MongoDB Atlas or Local MongoDB)
# ------------------------------------------------------------------------------
# For MongoDB Atlas (Recommended for Cloud Hosting):
# Format: mongodb+srv://<db_username>:<db_password>@<cluster_name>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_db_username:your_strong_db_password@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority

# Database name within the MongoDB cluster
DATABASE_NAME=scamshield_db

# ------------------------------------------------------------------------------
# Security & Authentication (JSON Web Tokens)
# ------------------------------------------------------------------------------
# Generate a cryptographically secure key: `openssl rand -hex 32`
JWT_SECRET=your_generated_cryptographically_secure_jwt_secret_key_minimum_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# Cross-Origin Resource Sharing (CORS) Configuration
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend domain URLs (without trailing slashes).
# Example: https://scamshield.vercel.app,https://yourcustomdomain.com
CORS_ORIGINS=https://your-frontend-domain.vercel.app,http://localhost:5173
FRONTEND_ORIGIN=https://your-frontend-domain.vercel.app

# ------------------------------------------------------------------------------
# Bootstrapped Administrator Account Credentials
# ------------------------------------------------------------------------------
# Used once on startup to seed the initial security moderator account if not present.
DEFAULT_ADMIN_EMAIL=admin@yourdomain.org
DEFAULT_ADMIN_PASSWORD=ReplaceWithAStrongAdminPassword_Min12Chars!

# ------------------------------------------------------------------------------
# Frontend Specific Configuration (Vite)
# ------------------------------------------------------------------------------
# For separate frontend hosting (Vercel/Netlify), set the full URL to the backend API:
# Example: https://scamshield-api.onrender.com/api
VITE_API_BASE_URL=https://your-backend-api.onrender.com/api
VITE_ENABLE_DEMO_CREDENTIALS=false
