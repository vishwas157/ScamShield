# ==============================================================================
# ScamShield Backend Environment Configuration Template
# ==============================================================================
# Copy this file to backend/.env in your deployment or local environment.
# All values below are placeholder examples. Never commit production secrets.
# ==============================================================================

PROJECT_NAME="ScamShield — Scam Number & UPI Community Database"
ENVIRONMENT=production
VERSION=1.0.0
API_V1_STR=/api
PORT=8000

# Database Configuration (MongoDB Atlas or Local MongoDB)
# For local evaluation: mongodb://127.0.0.1:27017
# For MongoDB Atlas:
MONGODB_URI=mongodb+srv://your_db_username:your_strong_db_password@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=scamshield_db

# Security & JSON Web Tokens
# Generate with: openssl rand -hex 32
JWT_SECRET=your_generated_cryptographically_secure_jwt_secret_key_minimum_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Production CORS Allowed Origins (Comma-separated)
# Include your deployed frontend URL (e.g., Vercel, Netlify, custom domain)
CORS_ORIGINS=https://your-frontend-deployment.vercel.app,http://localhost:5173
FRONTEND_ORIGIN=https://your-frontend-deployment.vercel.app

# Bootstrapped Administrator Account (Created on first run if not present)
DEFAULT_ADMIN_EMAIL=admin@yourdomain.org
DEFAULT_ADMIN_PASSWORD=ReplaceWithAStrongAdminPassword_Min12Chars!

# Machine Learning Paths
ML_MODEL_PATH=app/ml/saved_model.joblib
ML_METADATA_PATH=app/ml/saved_metadata.json
